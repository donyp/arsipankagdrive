# Pusat Arsip Anka - Environment Configuration Template
# Copy this file to backend/.env and fill with your actual values

# ============================================
# Application Port Configuration
# ============================================
# For different hosting platforms:
# - Local development: 5000
# - Hugging Face Spaces: 7860
# - Cloud Run / Railway: 8080
PORT=5000

# ============================================
# Environment Mode
# ============================================
# development = localhost origins allowed + all CORS origins
# production = only ALLOWED_ORIGINS accepted
NODE_ENV=development

# ============================================
# Supabase Database Configuration
# ============================================
# Get these from your Supabase project settings
# Dashboard: https://app.supabase.com/projects
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Authentication & Security
# ============================================
# Generate new secrets with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_key_min_32_characters_long_here
JWT_EXPIRES_IN=24h

# Session secret for express sessions
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=your_session_secret_base64_encoded_here

# ============================================
# CORS - Allowed Origins (PRODUCTION SECURITY)
# ============================================
# Format: comma-separated list of allowed origins
# Development: Leave empty or use localhost (automatic)
# Production: Specify exact domains only
# Example: https://example.com,https://admin.example.com
# CRITICAL: In production, DO NOT use * or wildcard (insecure)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================
# Notifications (Optional)
# ============================================
# Fonnte WhatsApp API (optional for notifications)
FONNTE_TOKEN=your-fonnte-api-token-here

# ============================================
# Storage Configuration (Optional)
# ============================================
# If using rclone for file storage
RCLONE_CONFIG_PATH=./rclone.conf
STORAGE_BACKEND=terabox

# ============================================
# Alist Configuration (Optional)
# ============================================
# Enable or disable Alist service
ENABLE_ALIST=true
ALIST_PORT=5244
ALIST_DATA_PATH=/app/data

# ============================================
# Logging Configuration
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
LOG_PATH=/app/backend/logs

# ============================================
# File Upload Limits
# ============================================
MAX_FILE_SIZE=104857600  # 100MB in bytes
UPLOAD_TEMP_PATH=/app/backend/tmp

# ============================================
# Database Backup Configuration
# ============================================
# Number of backup files to retain before deleting oldest
BACKUP_RETENTION_COUNT=30

# ============================================
# System Configuration
# ============================================
# Enable maintenance mode (true/false)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Sistem sedang dalam pemeliharaan. Silakan coba lagi nanti.
