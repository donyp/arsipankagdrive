# ============================================
# Pusat Arsip Anka - Backend Environment
# ============================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# DO NOT COMMIT .env FILE TO GIT

# ============================================
# CRITICAL - Database Configuration
# ============================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# CRITICAL - Authentication
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-256-bit-hex-string-here
JWT_EXPIRES_IN=24h

# ============================================
# Deployment Configuration
# ============================================
PORT=5000
NODE_ENV=production

# ============================================
# RECOMMENDED - Session & Security
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=your-random-base64-string-here

# ============================================
# Storage Configuration (Primary: Google Drive)
# ============================================
STORAGE_BACKEND=gdrive
RCLONE_BIN=rclone
RCLONE_CONFIG_PATH=./rclone.conf
RCLONE_REMOTE=gdrive
ENABLE_ALIST=false
ENABLE_GDRIVE_SYNC=true

# ============================================
# Google Drive Configuration
# ============================================
GDRIVE_REMOTE_NAME=gdrive
GDRIVE_CONFIG_PATH=./rclone.conf

# ============================================
# Notifications (Optional)
# ============================================
# Get from Fonnte integration dashboard
FONNTE_TOKEN=your-fonnte-token-here

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=104857600
UPLOAD_TEMP_PATH=./backend/tmp

# ============================================
# Rclone Base Path Configuration
# ============================================
RCLONE_BASE_PATH=/ARSIP ANKA

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_PATH=./logs

# ============================================
# CORS Configuration
# ============================================
# Set to specific origins in production: https://example.com,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================
# Auto-Logout Configuration
# ============================================
# Time when all users are automatically logged out (HH:MM format, 24-hour)
# Example: 18:00 = 6 PM, 17:00 = 5 PM, 00:00 = midnight
# Users will see a 5-minute warning before automatic logout
AUTO_LOGOUT_TIME=18:00
